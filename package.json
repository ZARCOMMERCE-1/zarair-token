{
  "name": "zarair-token",
  "version": "1.0.0",
  "description": "Sprint 1 BEP-20 compatible token implementation for Zar Air.",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:bsc-testnet": "hardhat run scripts/deploy.ts --network bscTestnet",
    "deploy:bsc-mainnet": "hardhat run scripts/deploy.ts --network bscMainnet",
    "deploy:sale:bsc-testnet": "hardhat run scripts/deploy-sale.ts --network bscTestnet",
    "lint": "eslint \"{hardhat.config.ts,scripts/**/*.ts,test/**/*.ts}\"",
    "format": "prettier --write \"contracts/**/*.sol\" \"scripts/**/*.ts\" \"test/**/*.ts\" \"*.ts\" \"*.md\""
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/node": "^20.11.30",
    "@types/chai": "^4.3.11",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "chai": "^4.4.1",
    "eslint": "^8.57.0",
    "hardhat": "^2.22.2",
    "prettier": "^3.2.5",
    "prettier-plugin-solidity": "^1.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.2"
  }
}
